@model RWMS.Models.ViewModels.Account.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="rwms-auth-brand">
    <h1 class="rwms-auth-brand-name">RWMS</h1>
    <p class="rwms-auth-brand-tagline">Restaurant Wholesale Management</p>
</div>

<div class="rwms-auth-card">
    <h2 class="rwms-auth-title">Forgot your password?</h2>

    @if (TempData["Info"] is string info)
    {
        <div class="rwms-auth-alert is-info">@info</div>
    }

    <p style="text-align:center; color:var(--color-text-muted); font-size:0.9rem; margin-bottom:var(--space-6);">
        Enter your email and we'll send you a reset link.
    </p>

    <form asp-action="ForgotPassword" method="post" class="rwms-auth-form">
        <div asp-validation-summary="ModelOnly" class="rwms-auth-alert is-error"></div>

        <div class="rwms-field">
            <label>Email</label>
            <input asp-for="Email" class="rwms-input" placeholder="you@company.com" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <button type="submit" class="rwms-auth-btn">Send Reset Link</button>
    </form>

    <div class="rwms-auth-links">
        <a asp-action="Login">Back to login</a>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

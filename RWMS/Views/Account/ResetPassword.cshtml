@model RWMS.Models.ViewModels.Account.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="rwms-auth-brand">
    <h1 class="rwms-auth-brand-name">RWMS</h1>
    <p class="rwms-auth-brand-tagline">Restaurant Wholesale Management</p>
</div>

<div class="rwms-auth-card">
    <h2 class="rwms-auth-title">Set a new password</h2>

    <form asp-action="ResetPassword" method="post" class="rwms-auth-form">
        <div asp-validation-summary="ModelOnly" class="rwms-auth-alert is-error"></div>

        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />

        <div class="rwms-field">
            <label>New Password</label>
            <input asp-for="NewPassword" type="password" class="rwms-input" placeholder="Choose a new password" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="rwms-field">
            <label>Confirm New Password</label>
            <input asp-for="ConfirmNewPassword" type="password" class="rwms-input" placeholder="Confirm your new password" autocomplete="new-password" />
            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="rwms-auth-btn">Reset Password</button>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

@model RWMS.Models.ViewModels.Account.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="rwms-auth-brand">
    <h1 class="rwms-auth-brand-name">RWMS</h1>
    <p class="rwms-auth-brand-tagline">Restaurant Wholesale Management</p>
</div>

<div class="rwms-auth-card rwms-auth-card-register">
    <h2 class="rwms-auth-title">Create an account</h2>

    <form asp-action="Register" method="post" class="rwms-auth-form">
        <input type="hidden" asp-for="Token" />
        <div asp-validation-summary="ModelOnly" class="rwms-auth-alert is-error"></div>

        <div class="rwms-field-row">
            <div class="rwms-field">
                <label>First Name</label>
                <input asp-for="FirstName" class="rwms-input" placeholder="First name" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="rwms-field">
                <label>Last Name</label>
                <input asp-for="LastName" class="rwms-input" placeholder="Last name" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>

        <div class="rwms-field">
            <label>Email</label>
            <input asp-for="Email" class="rwms-input" placeholder="you@company.com" autocomplete="username" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="rwms-field">
            <label>Password</label>
            <input asp-for="Password" type="password" class="rwms-input" placeholder="Choose a password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="rwms-field">
            <label>Confirm Password</label>
            <input asp-for="ConfirmPassword" type="password" class="rwms-input" placeholder="Confirm your password" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="rwms-auth-btn">Register</button>
    </form>

    <div class="rwms-auth-link">
        Already have an account?
        <a asp-action="Login">Log in</a>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

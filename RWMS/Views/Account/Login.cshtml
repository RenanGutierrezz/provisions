@model RWMS.Models.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="rwms-auth-brand">
    <h1 class="rwms-auth-brand-name">RWMS</h1>
    <p class="rwms-auth-brand-tagline">Restaurant Wholesale Management</p>
</div>

<div class="rwms-auth-card">
    <h2 class="rwms-auth-title">Log in</h2>

    @if (TempData["Error"] is string err)
    {
        <div class="rwms-auth-alert is-error">@err</div>
    }
    @if (TempData["Info"] is string info)
    {
        <div class="rwms-auth-alert is-info">@info</div>
    }

    <form asp-action="Login" method="post" class="rwms-auth-form">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        <div asp-validation-summary="ModelOnly" class="rwms-auth-alert is-error"></div>

        <div class="rwms-field">
            <label>Email</label>
            <input asp-for="Email" class="rwms-input" placeholder="you@company.com" autocomplete="username" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="rwms-field">
            <label>Password</label>
            <input asp-for="Password" type="password" class="rwms-input" placeholder="Enter your password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="rwms-remember">
            <input asp-for="RememberMe" />
            <label>Remember me</label>
        </div>

        <button type="submit" class="rwms-auth-btn">Continue</button>
    </form>

    <div class="rwms-auth-links">
        <a asp-action="ForgotPassword">Having trouble logging in?</a>
        <a asp-controller="AccountRequest" asp-action="Apply">Become a Customer</a>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

@model RWMS.Models.ErrorViewModel

@{
    var (title, message) = Model.StatusCode switch
    {
        403 => ("Access Denied", "You do not have permission to view this page."),
        404 => ("Page Not Found", "The page you are looking for does not exist or has been moved."),
        _   => ("Something Went Wrong", "An unexpected error occurred. Please try again later.")
    };

    ViewData["Title"] = title;
}

<div class="text-center mt-5">
    <h1 class="display-1 text-muted">@Model.StatusCode</h1>
    <h2 class="mb-3">@title</h2>
    <p class="text-muted mb-4">@message</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to Home</a>
</div>

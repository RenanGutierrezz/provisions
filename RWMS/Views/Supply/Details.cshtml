@model RWMS.Models.ViewModels.Supply.SupplyDetailViewModel

@{
    ViewData["Title"] = "Supply Item Details";
}

<div class="page rwms-supply-detail-page o-stack">
    <section class="card rwms-supply-detail-hero">
        <div class="rwms-supply-detail-hero-copy">
            <h2>@Model.Name</h2>
            @if (!string.IsNullOrWhiteSpace(Model.Category))
            {
                <p class="rwms-supply-copy">@Model.Category</p>
            }
        </div>
    </section>

    <section class="rwms-supply-detail-grid">
        <article class="card rwms-supply-detail-card">
            <div class="rwms-panel-header">
                <div>
                    <p class="rwms-section-kicker">Purchasing</p>
                    <h3>Item Details</h3>
                </div>
            </div>

            <dl class="rwms-supply-detail-list">
                <div>
                    <dt>Quantity Needed</dt>
                    <dd>@Model.QuantityNeeded @Model.Unit</dd>
                </div>
                <div>
                    <dt>Unit</dt>
                    <dd>@Model.Unit</dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Category))
                {
                    <div>
                        <dt>Category</dt>
                        <dd>@Model.Category</dd>
                    </div>
                }
            </dl>
        </article>

        <article class="card rwms-supply-detail-card">
            <div class="rwms-panel-header">
                <div>
                    <p class="rwms-section-kicker">Activity</p>
                    <h3>Timeline & Notes</h3>
                </div>
            </div>

            <dl class="rwms-supply-detail-list rwms-supply-detail-list-single">
                <div>
                    <dt>Added</dt>
                    <dd>@Model.CreatedAt.ToString("MMM d, yyyy")</dd>
                </div>
                @if (Model.UpdatedAt.HasValue)
                {
                    <div>
                        <dt>Last Updated</dt>
                        <dd>@Model.UpdatedAt.Value.ToString("MMM d, yyyy")</dd>
                    </div>
                }
                <div class="rwms-supply-detail-notes">
                    <dt>Notes</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes." : Model.Notes)</dd>
                </div>
            </dl>
        </article>
    </section>

    <section class="rwms-supply-detail-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn--primary">Edit Item</a>
        <a asp-action="Index" class="btn btn--secondary">Back to List</a>
    </section>
</div>

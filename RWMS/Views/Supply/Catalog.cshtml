@model List<RWMS.Models.ViewModels.Supply.SupplyCatalogItemViewModel>

@{
    ViewData["Title"] = "Supply Catalog";

    var groups = Model
        .GroupBy(i => string.IsNullOrWhiteSpace(i.Category) ? "Other" : i.Category)
        .OrderBy(g => g.Key)
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/supply-catalog.css" asp-append-version="true" />
}

<div class="page rwms-supply-page o-stack" data-catalog>
    <section class="rwms-supply-hero">
        <div class="rwms-supply-hero-text">
            <p class="rwms-supply-copy">Items you've bought before. Re-add them to the current supply list with one click.</p>
            <div class="rwms-supply-summary">
                <span class="rwms-supply-summary-chip is-total">@Model.Count item@(Model.Count == 1 ? "" : "s") in catalog</span>
            </div>
        </div>
        <div class="rwms-supply-hero-actions">
            <a asp-action="Index" class="btn btn--secondary">Back to Supply List</a>
            <a asp-action="Create" class="btn btn--primary">Add New Item</a>
        </div>
    </section>

    @if (!Model.Any())
    {
        <section class="empty-state card">
            No items in the catalog yet. Items appear here after you mark them as "Got it" on the supply list.
        </section>
    }
    else
    {
        <section class="rwms-catalog-toolbar">
            <label class="rwms-catalog-search">
                <i class="ti ti-search"></i>
                <input type="search" placeholder="Search the catalog..." aria-label="Search the catalog" data-catalog-search />
            </label>
            <div class="rwms-catalog-filters">
                <button type="button" class="rwms-catalog-filter is-active" data-catalog-filter="all">
                    All <span>@Model.Count</span>
                </button>
                @foreach (var group in groups)
                {
                    <button type="button" class="rwms-catalog-filter" data-catalog-filter="@group.Key">
                        @group.Key <span>@group.Count()</span>
                    </button>
                }
            </div>
        </section>

        @foreach (var group in groups)
        {
            <section class="rwms-catalog-section" data-catalog-section="@group.Key">
                <div class="rwms-catalog-section-head">
                    <span class="rwms-catalog-section-name">@group.Key</span>
                    <span class="rwms-catalog-section-count" data-catalog-count>@group.Count() item@(group.Count() == 1 ? "" : "s")</span>
                </div>

                <div class="rwms-catalog-grid">
                    @foreach (var item in group)
                    {
                        <article class="rwms-catalog-card" data-catalog-card data-name="@item.Name.ToLowerInvariant()">
                            <div>
                                <p class="rwms-catalog-card-eyebrow">@item.Unit</p>
                                <h3>@item.Name</h3>
                            </div>

                            <dl class="rwms-catalog-card-last">
                                <dt>Last qty</dt>
                                <dd>@item.LastQuantity @item.Unit</dd>
                            </dl>

                            <form asp-action="ReAdd" method="post" class="rwms-catalog-readd">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="number" name="quantity" value="@item.LastQuantity" min="1"
                                       class="rwms-catalog-qty" aria-label="Quantity for @item.Name" />
                                <button type="submit" class="btn btn--primary btn--sm">Add to List</button>
                            </form>

                            <div class="rwms-catalog-card-foot">
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                      onsubmit="return confirm('Permanently remove this item from the catalog?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="rwms-catalog-delete">Delete</button>
                                </form>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }

        <p class="rwms-catalog-noresults" data-catalog-noresults hidden>No catalog items match that search.</p>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const page = document.querySelector('[data-catalog]');
            const search = page.querySelector('[data-catalog-search]');
            if (!search) return;

            const filters = page.querySelectorAll('[data-catalog-filter]');
            const cards = page.querySelectorAll('[data-catalog-card]');
            const sections = page.querySelectorAll('[data-catalog-section]');
            const noResults = page.querySelector('[data-catalog-noresults]');
            let category = 'all';

            function apply() {
                const term = search.value.trim().toLowerCase();
                let shown = 0;

                cards.forEach(card => {
                    const visible = (category === 'all' || card.closest('[data-catalog-section]').dataset.catalogSection === category)
                        && (term === '' || card.dataset.name.includes(term));
                    card.hidden = !visible;
                    if (visible) shown++;
                });

                sections.forEach(section => {
                    const visible = section.querySelectorAll('[data-catalog-card]:not([hidden])').length;
                    section.hidden = visible === 0;
                    section.querySelector('[data-catalog-count]').textContent =
                        visible + (visible === 1 ? ' item' : ' items');
                });

                noResults.hidden = shown > 0;
            }

            search.addEventListener('input', apply);

            filters.forEach(button => {
                button.addEventListener('click', () => {
                    category = button.dataset.catalogFilter;
                    filters.forEach(b => b.classList.toggle('is-active', b === button));
                    apply();
                });
            });
        })();
    </script>
}

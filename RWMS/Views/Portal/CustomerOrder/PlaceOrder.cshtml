@model RWMS.Models.ViewModels.Portal.PlaceOrderViewModel
@{
    ViewData["Title"] = "Place an Order";
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
}

<div style="margin-bottom:2rem;">
    <h1 style="font-size:1.5rem;margin:0 0 0.25rem;">Place an Order</h1>
    <p style="color:var(--color-text-muted);font-size:0.9rem;margin:0;">Select products and a delivery date. We will confirm your order by email.</p>
</div>

<form asp-action="PlaceOrder" method="post" style="max-width:720px;">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="portal-alert portal-alert-error" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

    @* Delivery date *@
    <div class="portal-form-group">
        <label>Requested Delivery Date</label>
        <input asp-for="RequestedDeliveryDate"
               type="date"
               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="RequestedDeliveryDate" style="color:var(--red-700);font-size:0.8rem;"></span>
    </div>

    @* Notes *@
    <div class="portal-form-group">
        <label>Notes <span style="font-weight:400;text-transform:none;">(optional)</span></label>
        <textarea asp-for="Notes" rows="2" placeholder="Any special instructions..."></textarea>
    </div>

    @* Order items *@
    <div style="margin-bottom:1.5rem;">
        <p style="font-size:0.8rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 0.75rem;">Items</p>

        <div id="items-container">
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <div class="order-item-row" style="display:grid;grid-template-columns:1fr 120px 40px;gap:0.75rem;margin-bottom:0.75rem;align-items:center;">
                    <select name="Items[@i].ProductId"
                            style="padding:0.65rem 0.75rem;border:1px solid var(--black);font-family:var(--font-body);font-size:1rem;background:var(--white);">
                        <option value="0">Select a product...</option>
                        @foreach (var p in Model.Products)
                        {
                            var parHint = p.ParLevel.HasValue ? $" (PAR {p.ParLevel})" : "";
                            <option value="@p.Id" selected="@(Model.Items[i].ProductId == p.Id ? "selected" : null)">
                                @p.Name — $@p.Price.ToString("F2")/@p.Unit@parHint
                            </option>
                        }
                    </select>

                    <input type="number"
                           name="Items[@i].Quantity"
                           value="@Model.Items[i].Quantity"
                           min="1" max="10000"
                           placeholder="Qty"
                           style="padding:0.65rem 0.75rem;border:1px solid var(--black);font-family:var(--font-body);font-size:1rem;" />

                    <button type="button"
                            onclick="removeItem(this)"
                            style="background:none;border:1px solid var(--black);width:40px;height:44px;cursor:pointer;font-size:1.1rem;line-height:1;">
                        &times;
                    </button>
                </div>
            }
        </div>

        <button type="button" onclick="addItem()" class="portal-btn portal-btn-outline" style="margin-top:0.5rem;font-size:0.8rem;padding:0.5rem 1rem;">
            + Add Item
        </button>
    </div>

    <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <button type="submit" class="portal-btn">Submit Order</button>
        <a asp-controller="CustomerOrder" asp-action="Index" class="portal-btn portal-btn-outline">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        const products = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Products.Select(p => new { id = p.Id, label = $"{p.Name} — ${p.Price:F2}/{p.Unit}" + (p.ParLevel.HasValue ? $" (PAR {p.ParLevel})" : "") })
        ));

        let itemIndex = @Model.Items.Count;

        function addItem() {
            const container = document.getElementById('items-container');
            const row = document.createElement('div');
            row.className = 'order-item-row';
            row.style.cssText = 'display:grid;grid-template-columns:1fr 120px 40px;gap:0.75rem;margin-bottom:0.75rem;align-items:center;';

            const select = document.createElement('select');
            select.name = `Items[${itemIndex}].ProductId`;
            select.style.cssText = 'padding:0.65rem 0.75rem;border:1px solid var(--black);font-family:var(--font-body);font-size:1rem;background:var(--white);';
            select.innerHTML = '<option value="0">Select a product...</option>' +
                products.map(p => `<option value="${p.id}">${p.label}</option>`).join('');

            const qty = document.createElement('input');
            qty.type = 'number';
            qty.name = `Items[${itemIndex}].Quantity`;
            qty.value = '1';
            qty.min = '1';
            qty.max = '10000';
            qty.placeholder = 'Qty';
            qty.style.cssText = 'padding:0.65rem 0.75rem;border:1px solid var(--black);font-family:var(--font-body);font-size:1rem;';

            const remove = document.createElement('button');
            remove.type = 'button';
            remove.innerHTML = '&times;';
            remove.style.cssText = 'background:none;border:1px solid var(--black);width:40px;height:44px;cursor:pointer;font-size:1.1rem;line-height:1;';
            remove.onclick = function() { removeItem(this); };

            row.appendChild(select);
            row.appendChild(qty);
            row.appendChild(remove);
            container.appendChild(row);
            itemIndex++;
        }

        function removeItem(btn) {
            const rows = document.querySelectorAll('.order-item-row');
            if (rows.length <= 1) return;
            btn.closest('.order-item-row').remove();
        }
    </script>
}

@model RWMS.Models.ViewModels.Delivery.DeliveryDetailViewModel

@{
    ViewData["Title"] = $"Delivery — {Model.Date:dd MMM yyyy}";
}

<div class="page o-stack">
    @if (TempData["Success"] is string msg)
    {
        <div class="rwms-contact-success">@msg</div>
    }
    <section class="card rwms-order-details-hero">
        <div class="rwms-order-details-hero-content">
            <div>
                <h2>@Model.Date.ToString("dddd, dd MMM yyyy")</h2>
                <p class="rwms-order-details-meta">Driver: @Model.DriverName · @Model.Stops.Count stop(s)</p>
            </div>
            <div style="display:flex;gap:var(--space-3);align-items:center;flex-wrap:wrap;">
                <span class="rwms-orders-status @(Model.IsComplete ? "is-ready" : "is-pending")">
                    @(Model.IsComplete ? "Complete" : "Pending")
                </span>
                @if (Model.DriverId != null)
                {
                    <form asp-action="NotifyDriver" asp-route-id="@Model.Id" method="post" style="margin:0;">
                        <button type="submit" class="btn btn--secondary">Send to Driver</button>
                    </form>
                }
                <a asp-action="DownloadSheet" asp-route-id="@Model.Id" class="btn btn--primary">PDF</a>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <section class="card">
            <h3>Driver Notes</h3>
            <p>@Model.Notes</p>
        </section>
    }

    @if (!Model.Stops.Any())
    {
        <section class="empty-state card">
            <span>No orders assigned to this delivery yet.</span>
        </section>
    }
    else
    {
        <section class="o-stack">
            @foreach (var (stop, index) in Model.Stops.Select((s, i) => (s, i)))
            {
                <article class="card">
                    <div class="rwms-order-details-hero-content">
                        <div>
                            <h3>Stop @(index + 1) — @stop.CustomerName</h3>
                            @if (!string.IsNullOrWhiteSpace(stop.CustomerAddress))
                            {
                                <p class="rwms-order-details-meta">@stop.CustomerAddress</p>
                            }
                        </div>
                        <div style="display:flex;gap:var(--space-3);align-items:center;">
                            <span class="rwms-order-details-meta">Order #@stop.OrderId</span>
                            @if (!Model.IsComplete)
                            {
                                <form asp-action="UnassignOrder" method="post">
                                    <input type="hidden" name="deliveryId" value="@Model.Id" />
                                    <input type="hidden" name="orderId" value="@stop.OrderId" />
                                    <button type="submit" class="btn btn--danger">Remove</button>
                                </form>
                            }
                        </div>
                    </div>
                    <ul style="margin-top:var(--space-4);padding-left:var(--space-5);">
                        @foreach (var item in stop.ItemSummaries)
                        {
                            <li>@item</li>
                        }
                    </ul>
                    @if (User.IsInRole("Owner"))
                    {
                        <p style="text-align:right;margin-top:var(--space-4);font-weight:600;">Total: @stop.TotalAmount.ToString("C")</p>
                    }
                </article>
            }
        </section>
    }

    @if (!Model.IsComplete)
    {
        @if (Model.AvailableOrders.Any())
        {
            <section class="card">
                <h3>Add Stop</h3>
                <form asp-action="AssignOrder" method="post" class="rwms-delivery-assign-form">
                    <input type="hidden" name="deliveryId" value="@Model.Id" />
                    <select name="orderId" class="rwms-contact-input">
                        @foreach (var order in Model.AvailableOrders)
                        {
                            <option value="@order.Id">@order.Label</option>
                        }
                    </select>
                    <button type="submit" class="btn btn--primary">Add Stop</button>
                </form>
            </section>
        }
        else
        {
            <section class="card">
                <h3>Add Stop</h3>
                <p class="rwms-order-details-meta">No orders are ready for delivery. Accept orders and mark them <strong>Ready for Delivery</strong> first.</p>
            </section>
        }

        <section class="card">
            <h3>Mark Complete</h3>
            <form asp-action="Complete" asp-route-id="@Model.Id" method="post" style="margin-top:var(--space-4);">
                <button type="submit" class="btn btn--primary"
                        onclick="return confirm('Mark this delivery as complete?')">
                    Mark as Complete
                </button>
            </form>
        </section>
    }

    <section class="rwms-order-details-back">
        <a asp-action="Index" class="btn btn--secondary">Back to Deliveries</a>
    </section>
</div>